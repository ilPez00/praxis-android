<?xml version="1.0" encoding="utf-8"?>
<!-- Four equal tap targets: three quick-log buttons and one "more" that opens
     the trackers screen. Emojis as labels — no icon assets to ship, and the
     glyphs render on every launcher we have seen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quicklog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_quicklog_header"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_quicklog_b1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_quicklog_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
        </LinearLayout>

        <Space android:layout_width="6dp" android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/widget_quicklog_b2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_quicklog_t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
        </LinearLayout>

        <Space android:layout_width="6dp" android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/widget_quicklog_b3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_quicklog_t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_quicklog_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="@string/widget_quicklog_more"
        android:textColor="@color/widget_accent"
        android:textSize="11sp" />
</LinearLayout>
