<?xml version="1.0" encoding="utf-8"?>
<!-- Streak + today's check-in. Whole card is one tap target into check-in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_streak_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:text="@string/widget_streak_placeholder" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:text="@string/widget_day_streak" />

    <TextView
        android:id="@+id/widget_streak_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:text="@string/widget_not_checked_in" />
</LinearLayout>
