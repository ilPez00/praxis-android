<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget palette.

  Home-screen widgets do not inherit the app's theme, and they sit on a
  wallpaper the app cannot see, so these are chosen for contrast against an
  unknown background rather than to match the web app exactly. The card is
  near-opaque for that reason: a translucent widget is legible over a plain
  wallpaper and unreadable over a photograph.
-->
<resources>
    <!-- AppCompat theme anchors (kept from the original native scaffold). -->
    <color name="colorPrimary">#6200EE</color>
    <color name="colorPrimaryDark">#3700B3</color>
    <color name="colorAccent">#03DAC6</color>

    <color name="widget_background">#F21B1B1F</color>
    <color name="widget_surface">#FF26262C</color>
    <color name="widget_text_primary">#FFF5F5F7</color>
    <color name="widget_text_secondary">#FFA0A0AB</color>
    <color name="widget_accent">#FF7C5CFF</color>
    <color name="widget_positive">#FF4ADE80</color>
    <color name="widget_calories">#FFFFA94D</color>
    <color name="widget_volume">#FF7C5CFF</color>
    <color name="widget_protein">#FF4ADE80</color>
    <color name="widget_carbs">#FF60A5FA</color>
    <color name="widget_fat">#FFFBBF24</color>
</resources>
